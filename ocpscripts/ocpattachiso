#!/usr/bin/env bash

# Load configuration (global first, then user override)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$HOME/.tmux/config.sh" ]; then
    source "$HOME/.tmux/config.sh"
fi

CLUSTERS_BASE_PATH="${CLUSTERS_BASE_PATH:-/vms/clusters}"
OPENSHIFT4_AUTOMATION_PATH="${OPENSHIFT4_AUTOMATION_PATH:-$HOME/git/openshift4-automation}"

if [ -z "$1" ]; then
    echo "Error: Cluster name is required"
    echo "Usage: ocpattachiso <cluster-name> [cluster-path]"
    exit 1
fi

CLUSTER_NAME="$1"
CLUSTER_DIR="${2:-$CLUSTERS_BASE_PATH/$CLUSTER_NAME}"
CLUSTER_JSON="$CLUSTER_DIR/$CLUSTER_NAME.json"
TMP_JSON="/tmp/${CLUSTER_NAME}.json"

if [ ! -f "$CLUSTER_JSON" ]; then
    echo "Error: Cluster JSON not found: $CLUSTER_JSON"
    exit 1
fi

CONSOLE_INFO="$CLUSTER_DIR/assisted-console-info.txt"
ASSISTED_HOSTS="$CLUSTER_DIR/assisted-hosts.json"

if [ -f "$CONSOLE_INFO" ]; then
    cat "$CONSOLE_INFO"
    echo ""
elif [ -f "$ASSISTED_HOSTS" ]; then
    echo "Assisted Installer hosts for $CLUSTER_NAME:"
    echo "---"
    jq -r '.hosts[] | . as $h | $h.interfaces[]? | "  \($h.name)  \(.guest_name // .nic)  \(.mac)"' "$ASSISTED_HOSTS" 2>/dev/null \
        || jq -r '.hosts[] | "  \(.name)  \(.mac // "")"' "$ASSISTED_HOSTS" 2>/dev/null
    echo "---"
    echo ""
fi

read -rp "Assisted Installer ISO URL: " iso_url

if [ -z "$iso_url" ]; then
    echo "Error: ISO URL is required"
    exit 1
fi

PLAYBOOK="$OPENSHIFT4_AUTOMATION_PATH/create-master-vms-assisted-installer.yaml"

if [ ! -f "$PLAYBOOK" ]; then
    echo "Error: Playbook not found: $PLAYBOOK"
    exit 1
fi

# Persist iso_file in cluster variables for future reference
jq --arg url "$iso_url" '.iso_file = $url' "$CLUSTER_JSON" > "${CLUSTER_JSON}.tmp" \
    && mv "${CLUSTER_JSON}.tmp" "$CLUSTER_JSON"
cp "$CLUSTER_JSON" "$TMP_JSON"

echo ""
echo "Attaching ISO and powering on VMs for cluster: $CLUSTER_NAME"
echo "ISO: $iso_url"
echo ""

START_TIME=$(date +%s)

ansible-playbook "$PLAYBOOK" \
    -e "@$CLUSTER_JSON" \
    -e "clustername=$CLUSTER_NAME" \
    -e "iso_file=$iso_url"

if [ $? -ne 0 ]; then
    echo "Error: VM playbook failed"
    exit 1
fi

END_TIME=$(date +%s)
EXECUTION_TIME=$((END_TIME - START_TIME))
EXECUTION_TIME_FMT=$(printf '%dm%02ds' $((EXECUTION_TIME / 60)) $((EXECUTION_TIME % 60)))

echo ""
echo "Running post-install playbooks..."

if [ ! -f "$CLUSTER_DIR/0-chiaretto.conf" ]; then
    ansible-playbook "$OPENSHIFT4_AUTOMATION_PATH/configure-vpn.yaml" \
        -e "@$CLUSTER_JSON" \
        -e "clustername=$CLUSTER_NAME"
else
    echo "VPN config already exists, skipping configure-vpn.yaml"
fi

ansible-playbook "$OPENSHIFT4_AUTOMATION_PATH/send_mail_assisted_creation.yaml" \
    -e "@$CLUSTER_JSON" \
    -e "clustername=$CLUSTER_NAME" \
    -e "execution_time=$EXECUTION_TIME_FMT"

echo ""
echo "Assisted Installer deploy complete for $CLUSTER_NAME"
