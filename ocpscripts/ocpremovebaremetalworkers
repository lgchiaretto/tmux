#!/usr/bin/env bash

# Remove baremetal worker VMs from VMware and unregister them from redfish-vmware.
#
# Usage: ocpremovebaremetalworkers <cluster-name> [cluster-path]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$HOME/.tmux/config.sh" ]; then
    source "$HOME/.tmux/config.sh"
fi

CLUSTERS_BASE_PATH="${CLUSTERS_BASE_PATH:-/vms/clusters}"
OPENSHIFT4_AUTOMATION_PATH="${OPENSHIFT4_AUTOMATION_PATH:-$HOME/git/openshift4-automation}"

if [ -z "$1" ]; then
    echo "Error: Cluster name is required"
    echo "Usage: ocpremovebaremetalworkers <cluster-name> [cluster-path]"
    exit 1
fi

CLUSTER_NAME="$1"
CLUSTER_DIR="${2:-$CLUSTERS_BASE_PATH/$CLUSTER_NAME}"
CLUSTER_JSON="$CLUSTER_DIR/$CLUSTER_NAME.json"

if [ ! -f "$CLUSTER_JSON" ]; then
    echo "Error: Cluster JSON not found: $CLUSTER_JSON"
    exit 1
fi

PLATFORM=$(jq -r '.platform // ""' "$CLUSTER_JSON")
CURRENT_WORKERS=$(jq -r '.n_worker // "0"' "$CLUSTER_JSON")

if [ "$PLATFORM" != "baremetal" ]; then
    echo "Error: Cluster '$CLUSTER_NAME' is platform='$PLATFORM' (expected baremetal)"
    exit 1
fi

read -rp "Total worker VMs desired after removal (current n_worker=${CURRENT_WORKERS}): " N_WORKER

if [ -z "$N_WORKER" ]; then
    echo "Error: Worker count is required"
    exit 1
fi

if ! [[ "$N_WORKER" =~ ^[0-9]+$ ]]; then
    echo "Error: Worker count must be a non-negative integer"
    exit 1
fi

PLAYBOOK="$OPENSHIFT4_AUTOMATION_PATH/remove-baremetal-workers.yaml"
if [ ! -f "$PLAYBOOK" ]; then
    echo "Error: Playbook not found: $PLAYBOOK"
    exit 1
fi

if [ "$N_WORKER" -ge "$CURRENT_WORKERS" ]; then
    echo "Warning: Target n_worker (${N_WORKER}) is not lower than JSON n_worker (${CURRENT_WORKERS})."
    echo "The playbook uses the current VMware worker VM count as source of truth."
fi

WORKERS_TO_REMOVE_MSG="up to $((CURRENT_WORKERS - N_WORKER)) based on JSON n_worker"

echo ""
echo "Removing baremetal workers for cluster: $CLUSTER_NAME"
echo "Current n_worker: ${CURRENT_WORKERS}"
echo "Target n_worker: ${N_WORKER}"
echo "Workers to remove: ${WORKERS_TO_REMOVE_MSG}"
echo ""
read -rp "Continue? [y/N]: " CONFIRM

if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 0
fi

ansible-playbook "$PLAYBOOK" \
    -e "@$CLUSTER_JSON" \
    -e "clustername=$CLUSTER_NAME" \
    -e "n_worker=$N_WORKER"
